# Copy to keystore.properties (untracked) to sign a release build.
#
# Without it the release variant still builds, unsigned, which is enough to
# check that R8 and resource shrinking have not broken anything. Only the
# person shipping to a store needs a real one.
#
# storeFile is resolved from the repository root.
storeFile=release.keystore
storePassword=
keyAlias=
keyPassword=

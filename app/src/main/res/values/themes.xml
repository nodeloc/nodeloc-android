<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nodeloc" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nodeloc_bg</item>
    </style>

    <!-- Splash: brand colour plus the mark, matching Theme.bg in both schemes. -->
    <style name="Theme.Nodeloc.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nodeloc_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animation</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.Nodeloc</item>
    </style>
</resources>

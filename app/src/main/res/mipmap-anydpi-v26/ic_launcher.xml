<?xml version="1.0" encoding="utf-8"?>
<!--
  The knot mark from the green logo pack (app-icon-green-*), rendered to PNG
  per density because its strokes are cut by SVG masks, which a vector drawable
  cannot express. The pack's 1024 icon already sizes the mark so its farthest
  point is 36dp from the centre of a 108dp canvas, the edge of the round mask,
  so the layers are the pack's icons with their ground taken off.

  Light mode is the pack's "brand" icon (white mark on brand green); night is
  its "default" (light-green mark on deep green), from mipmap-night-*. The
  monochrome layer is the pack's mono mark, for themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
